        </mxCell>
        <mxCell id="e14-l" value="&lt;font style=&quot;background-color:#FFFFFF;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#232F3E&quot;&gt;21&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontFamily=Amazon Ember;" parent="e14" vertex="1" connectable="0">
          <mxGeometry relative="1" as="geometry">
