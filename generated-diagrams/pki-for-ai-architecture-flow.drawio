              <mxPoint x="845" y="275" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e15-l" value="&lt;font style=&quot;background-color:#FFFFFF;&quot;&gt;&lt;b&gt;&lt;font color=&quot;#01A88D&quot;&gt;22&lt;/font&gt;&lt;/b&gt;&lt;/font&gt;" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontFamily=Amazon Ember;" parent="e15" vertex="1" connectable="0">
